# Copy to .env and fill in. NEVER commit .env.

# --- Database (SQLite for dev; Postgres later: postgresql+psycopg://user:pass@host/db) ---
# DATABASE_URL=sqlite:///backend/clinic.db

# --- Booking backend: mock_rest | google_calendar (google_calendar arrives in Phase 5) ---
BOOKING_PROVIDER=mock_rest

# Base URL of the clinic system the mock_rest adapter talks to.
# In the demo this is our own server (it hosts the mock clinic API under /mock-clinic).
CLINIC_API_URL=http://127.0.0.1:8000

CLINIC_TIMEZONE=Asia/Kolkata

# Slot hold length in seconds (5 minutes) and how often the expiry sweeper runs.
HOLD_TTL_SECONDS=300
SWEEPER_INTERVAL_SECONDS=30

# Comma-separated list of origins allowed to call the API. "*" is fine for the hackathon demo.
CORS_ORIGINS=*

# --- Used from Phase 2 onward ---
GEMINI_API_KEY=
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash
